#!/bin/sh

SYSCTL_FS=${SYSCTL_FS:-/proc/sys/fs}

# Root writes and reads files in /tmp, where every account can write. The
# kernel then refuses to follow another account's link there, to hard-link a
# file one cannot write, and to open another account's file or FIFO there for
# writing. The image sets the same in /etc/sysctl.d; this also covers older ones.
protect_shared_directories() {
        for knob in protected_symlinks protected_hardlinks
        do
                { echo 1 > "$SYSCTL_FS/$knob"; } 2>/dev/null || true
        done
        for knob in protected_regular protected_fifos
        do
                { echo 2 > "$SYSCTL_FS/$knob"; } 2>/dev/null || true
        done
}

if [ "$1" = "start" ]
then
        protect_shared_directories

        DATA_DEVICE=/dev/mmcblk0p3
        DATA_MOUNT=/data
        DATA_LOG=/tmp/data-mount.log
        RAW_UPDATE_MARKER="$DATA_MOUNT/hardened-system-raw-update-pending.json"
        RAW_RESTORE_ROOT="$DATA_MOUNT/.hardened-kvmcache/system-update/preserve/root"
        RAW_RESTORE_DONE="$DATA_MOUNT/.hardened-kvmcache/system-update/root-restore-done"
        RAW_RESTORE_LOG="$DATA_MOUNT/hardened-system-raw-update.log"

        log_data() {
                echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$RAW_RESTORE_LOG" 2>/dev/null || true
        }

        mount_data_partition() {
                [ -e "$DATA_DEVICE" ] || return 0
                mkdir -p "$DATA_MOUNT"
                grep -q " $DATA_MOUNT " /proc/mounts && return 0

                i=0
                while [ "$i" -lt 5 ]
                do
                        if mount -t exfat "$DATA_DEVICE" "$DATA_MOUNT" >> "$DATA_LOG" 2>&1
                        then
                                return 0
                        fi
                        i=$((i + 1))
                        sleep 1
                done

                echo "failed to mount $DATA_DEVICE on $DATA_MOUNT" >> "$DATA_LOG"
                return 1
        }

        wait_for_data_device() {
                i=0
                while [ "$i" -lt 5 ]
                do
                        [ -e "$DATA_DEVICE" ] && return 0
                        i=$((i + 1))
                        sleep 1
                done

                return 1
        }

        ensure_data_partition() {
                [ -e /boot/usb.disk0 ] || return 0

                if [ -e "$DATA_DEVICE" ]
                then
                        touch /etc/kvm.disk0
                        return 0
                fi

                echo "creating $DATA_DEVICE" >> "$DATA_LOG"
                # the data partition takes everything after the root partition, 1 MiB aligned
                root_start=$(cat /sys/class/block/mmcblk0p2/start 2>/dev/null)
                root_size=$(cat /sys/class/block/mmcblk0p2/size 2>/dev/null)
                if [ -z "$root_start" ] || [ -z "$root_size" ]
                then
                        echo "cannot read the root partition size" >> "$DATA_LOG"
                        return 1
                fi
                data_start=$(( (root_start + root_size + 2047) / 2048 * 2048 ))
                parted -s /dev/mmcblk0 "unit s mkpart primary ${data_start}s 100%" >> "$DATA_LOG" 2>&1 || {
                        echo "failed to create $DATA_DEVICE" >> "$DATA_LOG"
                        return 1
                }

                if ! wait_for_data_device
                then
                        echo "$DATA_DEVICE did not appear after partition create" >> "$DATA_LOG"
                        return 1
                fi

                mkfs.exfat "$DATA_DEVICE" >> "$DATA_LOG" 2>&1 || true
                touch /etc/kvm.disk0
                return 0
        }

        restore_preserved_path() {
                rel="$1"
                src="$RAW_RESTORE_ROOT/$rel"
                dest="/$rel"
                dest_dir="${dest%/*}"
                [ -n "$dest_dir" ] || dest_dir=/

                [ -e "$src" ] || return 0
                mkdir -p "$dest_dir" || {
                        log_data "failed to create restore directory for /$rel"
                        return 0
                }

                if [ -d "$src" ]
                then
                        mkdir -p "$dest" || {
                                log_data "failed to create restore directory /$rel"
                                return 0
                        }
                        cp -a "$src/." "$dest/" >> "$RAW_RESTORE_LOG" 2>&1 || log_data "failed to restore /$rel"
                else
                        rm -f "$dest" 2>/dev/null || true
                        cp -p "$src" "$dest" >> "$RAW_RESTORE_LOG" 2>&1 || log_data "failed to restore /$rel"
                fi
        }

        fix_restored_permissions() {
                [ -f /etc/passwd ] && chmod 0644 /etc/passwd
                [ -f /etc/group ] && chmod 0644 /etc/group
                [ -f /etc/shadow ] && chmod 0600 /etc/shadow
                [ -f /etc/gshadow ] && chmod 0600 /etc/gshadow
                [ -f /device_key ] && chmod 0644 /device_key
                [ -d /etc/kvm ] && chmod 0755 /etc/kvm
                [ -f /etc/kvm/pwd ] && chmod 0600 /etc/kvm/pwd
                [ -f /etc/kvm/session_secret ] && chmod 0600 /etc/kvm/session_secret
                [ -f /etc/kvm/server.yaml ] && chmod 0644 /etc/kvm/server.yaml
                [ -f /etc/kvm/backend ] && chmod 0644 /etc/kvm/backend
                [ -f /etc/default/syslogd ] && chmod 0644 /etc/default/syslogd
                [ -f /etc/default/klogd ] && chmod 0644 /etc/default/klogd

                if [ -d /etc/ssh ]
                then
                        chmod 0755 /etc/ssh
                        chmod 0600 /etc/ssh/ssh_host_*_key 2>/dev/null || true
                        chmod 0644 /etc/ssh/ssh_host_*_key.pub /etc/ssh/ssh_config /etc/ssh/sshd_config /etc/ssh/moduli 2>/dev/null || true
                fi

                [ -x /usr/bin/tailscale ] && chmod 0755 /usr/bin/tailscale
                [ -x /usr/sbin/tailscaled ] && chmod 0755 /usr/sbin/tailscaled
                [ -x /usr/bin/picoclaw ] && chmod 0755 /usr/bin/picoclaw
                [ -x /etc/init.d/S96picoclaw ] && chmod 0755 /etc/init.d/S96picoclaw
                [ -x /etc/init.d/S98tailscaled ] && chmod 0755 /etc/init.d/S98tailscaled
        }

        apply_restored_runtime_state() {
                restored_hostname="$(head -n 1 /etc/hostname 2>/dev/null | tr -d '\r\n')"
                if [ -n "$restored_hostname" ]
                then
                        hostname "$restored_hostname" >> "$RAW_RESTORE_LOG" 2>&1 || \
                                log_data "failed to apply restored hostname"
                fi
        }

        # While the virtual disk shares the raw partition as a writable disk, the host is the
        # only writer, so /data is read-only here.
        remount_data_readonly_if_shared() {
                [ -e /boot/usb.disk0 ] || return 0
                [ ! -e /boot/usb.disk0.ro ] || return 0
                [ ! -s /boot/usb.disk0 ] || return 0
                grep -q " $DATA_MOUNT " /proc/mounts || return 0

                mount -o remount,ro "$DATA_MOUNT" >> "$DATA_LOG" 2>&1 ||
                        echo "failed to remount $DATA_MOUNT read-only" >> "$DATA_LOG"
        }

        restore_raw_root_config() {
                [ -f "$RAW_UPDATE_MARKER" ] || return 0
                [ -d "$RAW_RESTORE_ROOT" ] || return 0
                [ -f "$RAW_RESTORE_DONE" ] && return 0

                log_data "restoring preserved root configuration after raw system update boot"
                for rel in \
                        etc/kvm \
                        etc/default/syslogd \
                        etc/default/klogd \
                        etc/ssh \
                        etc/dropbear \
                        etc/passwd \
                        etc/shadow \
                        etc/group \
                        etc/gshadow \
                        etc/kvm.disk0 \
                        etc/hostname \
                        etc/machine-id \
                        etc/resolv.conf \
                        device_key \
                        root/.tailscale \
                        root/.picoclaw \
                        root/.picoclaw-cache \
                        var/lib/tailscale \
                        usr/bin/tailscale \
                        usr/sbin/tailscaled \
                        usr/bin/picoclaw \
                        etc/init.d/S96picoclaw \
                        etc/init.d/S98tailscaled \
                        etc/GOMEMLIMIT
                do
                        restore_preserved_path "$rel"
                done
                fix_restored_permissions
                apply_restored_runtime_state
                date '+%Y-%m-%d %H:%M:%S' > "$RAW_RESTORE_DONE" 2>/dev/null || true
                log_data "preserved root configuration restore finished"
        }

        # The kernel refuses to grow a filesystem that is flagged with errors, and a raw system
        # update can leave that flag behind. Check it once, before the resize below. RTC_INFO2
        # remembers an attempt across the restart, so a filesystem that stays flagged is left
        # alone until the next power cycle.
        heal_root_filesystem() {
                ROOT_DEVICE=/dev/mmcblk0p2
                GUARD_REG=0x05026024
                GUARD_MAGIC=0x66736B31
                GUARD_DEFAULT=0xABCD1234

                command -v dumpe2fs >/dev/null 2>&1 || return 0
                command -v e2fsck >/dev/null 2>&1 || return 0
                state=$(dumpe2fs -h "$ROOT_DEVICE" 2>/dev/null | sed -n 's/^Filesystem state: *//p')
                case "$state" in
                *rror*) ;;
                *)
                        devmem "$GUARD_REG" 32 "$GUARD_DEFAULT" >/dev/null 2>&1 || true
                        return 0
                        ;;
                esac

                if [ "$(devmem "$GUARD_REG" 32 2>/dev/null)" = "$GUARD_MAGIC" ]; then
                        echo "rootfs still flagged with errors after a check; leaving it" > /dev/kmsg 2>/dev/null || true
                        return 0
                fi
                devmem "$GUARD_REG" 32 "$GUARD_MAGIC" >/dev/null 2>&1 || return 0

                echo "rootfs is flagged with errors; checking it" > /dev/kmsg 2>/dev/null || true
                # only the root filesystem is mounted this early, so the emergency remount is safe
                echo u > /proc/sysrq-trigger 2>/dev/null || return 0
                e2fsck -fy "$ROOT_DEVICE" >/dev/null 2>&1
                rc=$?
                if [ "$rc" -eq 0 ]; then
                        # nothing was changed on disk but the flag; the remount reads it again
                        mount -o remount,rw / 2>/dev/null || true
                        echo "rootfs check found nothing to repair" > /dev/kmsg 2>/dev/null || true
                        return 0
                fi
                if [ $((rc & 4)) -ne 0 ] || [ $((rc & 8)) -ne 0 ]; then
                        mount -o remount,rw / 2>/dev/null || true
                        echo "rootfs check failed rc=$rc" > /dev/kmsg 2>/dev/null || true
                        return 0
                fi
                # repaired: the mounted copy is stale, so restart on the repaired one
                echo "rootfs repaired rc=$rc; restarting" > /dev/kmsg 2>/dev/null || true
                echo s > /proc/sysrq-trigger 2>/dev/null || true
                echo b > /proc/sysrq-trigger 2>/dev/null || true
        }

        restore_swap() {
                # /boot is mounted a little later in this script
                i=0
                while [ "$i" -lt 20 ] && ! grep -q " /boot " /proc/mounts 2>/dev/null
                do
                        sleep 1
                        i=$((i + 1))
                done
                [ -f /boot/swap.size ] || return 0
                swap_size=$(cat /boot/swap.size 2>/dev/null)
                case "$swap_size" in
                64|128|256) ;;
                *) return 0 ;;
                esac
                grep -q "^/swapfile " /proc/swaps 2>/dev/null && return 0

                if [ ! -f /swapfile ]
                then
                        fallocate -l "${swap_size}M" /swapfile 2>/dev/null || {
                                rm -f /swapfile
                                echo "swap file of ${swap_size}M does not fit; swap stays off" > /dev/kmsg 2>/dev/null
                                return 0
                        }
                        chmod 600 /swapfile
                        mkswap /swapfile >/dev/null 2>&1 || { rm -f /swapfile; return 0; }
                fi
                swapon /swapfile 2>/dev/null || return 0
                # keep the boot-time swapon line the server writes, so the next boot does not wait
                grep -q "swapon /swapfile" /etc/inittab 2>/dev/null || \
                        echo "si11::sysinit:/sbin/swapon /swapfile" >> /etc/inittab
        }

        heal_root_filesystem

                # grow the root filesystem into its partition, then bring swap back: a raw system
                # update replaces the swap file, and /boot/swap.size holds the size chosen
                (resize2fs /dev/mmcblk0p2; restore_swap) &


        . /etc/profile
        printf "mounting filesystem : "
        mkdir -p /boot
        mount -t vfat /dev/mmcblk0p1 /boot
        mount -t configfs configfs /sys/kernel/config
        mount -t debugfs debugfs /sys/kernel/debug

        ensure_data_partition || true
        mount_data_partition || true
        restore_raw_root_config
        # A pending system update still removes its marker from /data; S95nanokvm remounts
        # /data read-only once that is done.
        [ -f "$RAW_UPDATE_MARKER" ] || remount_data_readonly_if_shared

        echo "OK"
fi
