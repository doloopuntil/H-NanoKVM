From: Gleb Pesin <dormancygrace@gmail.com>
Date: Sun, 8 Nov 2026 01:34:22 +0200
Subject: [PATCH] rng: cv181x: seed the kernel from the SG2002 TRNG

A driver for the true random number generator of the CV181x/SG2002 security
subsystem, and board_rng_seed() for the LicheeRV Nano: U-Boot reads the
generator once per boot and puts 32 bytes into /chosen/rng-seed, which Linux
credits, so its random pool is ready before any driver runs (it took 11.9 s
on a NanoKVM Lite). With DM_RNG U-Boot also writes /chosen/kaslr-seed.

Linux has no driver for the block. It sits behind the efuse clock gates: a
register access while they are off hangs the bus, so the driver enables both
clocks before it touches a register. If the generator fails, U-Boot boots
without the seeds.

From NanoKVM-OS (platform/uboot/0010-rng-cv181x-trng.patch, commit 4d625675),
where it was checked on a NanoKVM PCIe. Adapted to this tree: the node goes
into sg2002-licheerv-nano-b.dts, which has no -u-boot.dtsi here, and the
Kconfig entry and the includes of board.c follow v2025.10 with the licheerv
patches.
---
diff --git a/arch/riscv/dts/sg2002-licheerv-nano-b.dts b/arch/riscv/dts/sg2002-licheerv-nano-b.dts
index 4dee967..cbd15e7 100644
--- a/arch/riscv/dts/sg2002-licheerv-nano-b.dts
+++ b/arch/riscv/dts/sg2002-licheerv-nano-b.dts
@@ -30,6 +30,17 @@
 	sysreset {
 		compatible = "sophgo,cv1800b-sysreset";
 	};
+
+	soc {
+		/* TRNG (drivers/rng/cv181x_trng.c): behind the efuse clock
+		 * gates; a register access while they are off hangs the bus. */
+		rng@2070000 {
+			compatible = "nanokvm,cv181x-trng";
+			reg = <0x2070000 0x1000>;
+			clocks = <&clk CLK_EFUSE>, <&clk CLK_APB_EFUSE>;
+			clock-names = "efuse", "apb_efuse";
+		};
+	};
 };
 
 &osc {
diff --git a/board/sophgo/licheerv_nano/board.c b/board/sophgo/licheerv_nano/board.c
index 415c2fc..01a6aad 100644
--- a/board/sophgo/licheerv_nano/board.c
+++ b/board/sophgo/licheerv_nano/board.c
@@ -3,8 +3,12 @@
  * Copyright (c) 2024, Kongyang Liu <seashell11234455@gmail.com>
  */
 
+#include <abuf.h>
+#include <dm.h>
 #include <env.h>
 #include <init.h>
+#include <malloc.h>
+#include <rng.h>
 #include <stdio.h>
 #include <asm/io.h>
 #include <linux/types.h>
@@ -67,3 +71,30 @@ int board_late_init(void)
 
 	return 0;
 }
+
+#if IS_ENABLED(CONFIG_BOARD_RNG_SEED)
+/* /chosen/rng-seed from the TRNG: 32 bytes, the 256 bits Linux needs to
+ * consider its CRNG seeded (it credits bootloader seeds by default). */
+#define RNG_SEED_LEN 32
+
+int board_rng_seed(struct abuf *buf)
+{
+	struct udevice *dev;
+	void *data;
+	int ret;
+
+	ret = uclass_get_device(UCLASS_RNG, 0, &dev);
+	if (ret)
+		return ret;
+	data = malloc(RNG_SEED_LEN);
+	if (!data)
+		return -ENOMEM;
+	ret = dm_rng_read(dev, data, RNG_SEED_LEN);
+	if (ret) {
+		free(data);
+		return ret;
+	}
+	abuf_init_move(buf, data, RNG_SEED_LEN);
+	return 0;
+}
+#endif
diff --git a/drivers/rng/Kconfig b/drivers/rng/Kconfig
index b35d8c6..8e59a12 100644
--- a/drivers/rng/Kconfig
+++ b/drivers/rng/Kconfig
@@ -23,6 +23,13 @@ config RNG_MESON
 	  Enable support for hardware random number generator
 	  of Amlogic Meson SoCs.
 
+config RNG_CV181X
+	bool "CV181x (SG2002) true random number generator"
+	depends on DM_RNG && CLK
+	help
+	  Enable the TRNG of the CV181x/SG2002 security subsystem, so that
+	  U-Boot can pass a rng-seed and a kaslr-seed to the kernel.
+
 config RNG_SANDBOX
 	bool "Sandbox random number generator"
 	depends on SANDBOX
diff --git a/drivers/rng/Makefile b/drivers/rng/Makefile
index 30c5827..86a8ea2 100644
--- a/drivers/rng/Makefile
+++ b/drivers/rng/Makefile
@@ -4,6 +4,7 @@
 #
 
 obj-$(CONFIG_$(PHASE_)DM_RNG) += rng-uclass.o
+obj-$(CONFIG_RNG_CV181X) += cv181x_trng.o
 obj-$(CONFIG_RNG_MESON) += meson-rng.o
 obj-$(CONFIG_RNG_SANDBOX) += sandbox_rng.o
 obj-$(CONFIG_RNG_MSM) += msm_rng.o
diff --git a/drivers/rng/cv181x_trng.c b/drivers/rng/cv181x_trng.c
new file mode 100644
index 0000000..3372121
--- /dev/null
+++ b/drivers/rng/cv181x_trng.c
@@ -0,0 +1,153 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CV181x (SG2002) true random number generator, for the rng-seed and
+ * kaslr-seed U-Boot puts into /chosen (Linux has no driver for it). The
+ * command sequence is that of the former Linux driver:
+ * - the TRNG seeds a DRBG from its noise source and returns 128 bits per
+ *   GEN_RANDOM command; each command waits until STAT.BUSY is clear, runs,
+ *   and is acknowledged by writing its ISTAT bit;
+ * - a second seed on an instantiated DRBG raises the "illegal command
+ *   sequence" alarm, after which the core ignores every command until the
+ *   alarm is cleared and the core zeroized; ZEROIZE with an alarm pending
+ *   hung the bus on the stand. So the seed clears ALARMS and ISTAT,
+ *   zeroizes, and instantiates from fresh noise; every command checks
+ *   ALARMS; the core is zeroized again after the read.
+ * - the block sits behind the efuse clock gates: with them off, any access
+ *   to its registers hangs the bus. The clocks are enabled before the first
+ *   register access.
+ */
+#include <clk.h>
+#include <dm.h>
+#include <rng.h>
+#include <asm/io.h>
+#include <dm/device_compat.h>
+#include <linux/bitops.h>
+#include <linux/iopoll.h>
+#include <linux/string.h>
+
+#define TRNG_CTRL 0x00
+#define TRNG_STAT 0x0c
+#define TRNG_ISTAT 0x14
+#define TRNG_ALARMS 0x18
+#define TRNG_RAND0 0x24
+#define TRNG_RAND_WORDS 4
+
+#define CMD_GEN_NOISE 0x1
+#define CMD_CREATE_STATE 0x3
+#define CMD_GEN_RANDOM 0x6
+#define CMD_ZEROIZE 0xf
+#define STAT_BUSY BIT(31)
+#define ISTAT_ZEROIZE BIT(0)
+#define ISTAT_DONE BIT(4)
+
+#define POLL_US 10
+#define TIMEOUT_US 100000
+
+struct cv181x_trng_priv {
+	void __iomem *base;
+};
+
+/* Run one command; completion is ISTAT bit done (ZEROIZE has its own). */
+static int trng_command(struct udevice *dev, u32 cmd, u32 done)
+{
+	struct cv181x_trng_priv *priv = dev_get_priv(dev);
+	u32 val;
+	int ret;
+
+	ret = readl_poll_timeout(priv->base + TRNG_STAT, val, !(val & STAT_BUSY),
+				 TIMEOUT_US);
+	if (ret)
+		return ret;
+	writel(cmd, priv->base + TRNG_CTRL);
+	ret = readl_poll_timeout(priv->base + TRNG_ISTAT, val, val & done,
+				 TIMEOUT_US);
+	writel(done, priv->base + TRNG_ISTAT);
+	if (ret)
+		return ret;
+	val = readl(priv->base + TRNG_ALARMS);
+	if (val) {
+		dev_err(dev, "alarm %#x after command %#x\n", val, cmd);
+		return -EIO;
+	}
+	return 0;
+}
+
+/* Clear any alarm, then zeroize: the only state every command sequence
+ * can start from. */
+static int trng_zeroize(struct udevice *dev)
+{
+	struct cv181x_trng_priv *priv = dev_get_priv(dev);
+
+	writel(~0u, priv->base + TRNG_ALARMS);
+	writel(~0u, priv->base + TRNG_ISTAT);
+	return trng_command(dev, CMD_ZEROIZE, ISTAT_ZEROIZE);
+}
+
+static int cv181x_trng_read(struct udevice *dev, void *data, size_t len)
+{
+	struct cv181x_trng_priv *priv = dev_get_priv(dev);
+	u32 words[TRNG_RAND_WORDS];
+	size_t done = 0, n;
+	int ret, i;
+
+	ret = trng_zeroize(dev);
+	if (!ret)
+		ret = trng_command(dev, CMD_GEN_NOISE, ISTAT_DONE);
+	if (!ret)
+		ret = trng_command(dev, CMD_CREATE_STATE, ISTAT_DONE);
+	while (!ret && done < len) {
+		ret = trng_command(dev, CMD_GEN_RANDOM, ISTAT_DONE);
+		if (ret)
+			break;
+		for (i = 0; i < TRNG_RAND_WORDS; i++)
+			words[i] = readl(priv->base + TRNG_RAND0 + 4 * i);
+		n = min(len - done, sizeof(words));
+		memcpy(data + done, words, n);
+		done += n;
+	}
+	memset(words, 0, sizeof(words));
+	/* Leave no DRBG state behind, and the core in the state every command
+	 * sequence starts from. */
+	if (trng_zeroize(dev) && !ret)
+		ret = -EIO;
+	return ret;
+}
+
+static int cv181x_trng_probe(struct udevice *dev)
+{
+	struct cv181x_trng_priv *priv = dev_get_priv(dev);
+	struct clk_bulk clks;
+	int ret;
+
+	/* Clocks first: the registers hang the bus while they are gated. */
+	ret = clk_get_bulk(dev, &clks);
+	if (ret)
+		return ret;
+	if (!clks.count)
+		return -EINVAL;
+	ret = clk_enable_bulk(&clks);
+	if (ret)
+		return ret;
+	priv->base = dev_read_addr_ptr(dev);
+	if (!priv->base)
+		return -EINVAL;
+	return 0;
+}
+
+static const struct dm_rng_ops cv181x_trng_ops = {
+	.read = cv181x_trng_read,
+};
+
+static const struct udevice_id cv181x_trng_ids[] = {
+	{ .compatible = "nanokvm,cv181x-trng" },
+	{ }
+};
+
+U_BOOT_DRIVER(cv181x_trng) = {
+	.name = "cv181x-trng",
+	.id = UCLASS_RNG,
+	.of_match = cv181x_trng_ids,
+	.ops = &cv181x_trng_ops,
+	.probe = cv181x_trng_probe,
+	.priv_auto = sizeof(struct cv181x_trng_priv),
+};
