@@ -66,6 +66,19 @@ static struct list_head sys_mem_bufs = LIST_HEAD_INIT(sys_mem_bufs);
 static DEFINE_MUTEX(sys_mem_lock);
 static struct device *sys_mem_dev;
 
+/* Whether [pa, pa + len) lies inside one allocated buffer. Caller holds sys_mem_lock. */
+static bool sys_mem_range_allocated(phys_addr_t pa, u64 len)
+{
+	struct sys_mem_buf *buf;
+
+	lockdep_assert_held(&sys_mem_lock);
+	list_for_each_entry(buf, &sys_mem_bufs, list) {
+		if (pa >= buf->paddr && len <= buf->size && pa - buf->paddr <= buf->size - len)
+			return true;
+	}
+	return false;
+}
