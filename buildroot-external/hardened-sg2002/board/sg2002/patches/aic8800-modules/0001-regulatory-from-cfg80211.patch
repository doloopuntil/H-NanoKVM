From: Gleb Pesin <dormancygrace@gmail.com>
Subject: [PATCH] aic8800: regulatory from cfg80211 and regulatory.db

custregd defaulted to true (its description said 0): the driver registered
as self-managed with a built-in "00" table that allows 2.4 GHz channels
1-14 and 5 GHz 36-165 at 20 dBm with no NO_IR or DFS rules, and ignored
every country change. It now defaults to false, so cfg80211 applies the
signed regulatory.db and the country set with iw, wpa_supplicant or
hostapd. The notifier no longer sends each change back as a driver hint
and no longer skips the firmware channel update for changes 100 ms apart.
Stopping the last interface sends the country last applied instead of
dereferencing wiphy->regd, which is RCU-managed and may be NULL.

From dormancygrace/NanoKVM-OS platform/modules/aic8800/0017, ported to
the varyhin/licheervnano source after licheerv's patches 0001-0004.
---
diff --git a/src/aic8800-vendor/aic8800_fdrv/rwnx_main.c b/src/aic8800-vendor/aic8800_fdrv/rwnx_main.c
index 754c4e2..4575eb3 100755
--- a/src/aic8800-vendor/aic8800_fdrv/rwnx_main.c
+++ b/src/aic8800-vendor/aic8800_fdrv/rwnx_main.c
@@ -1357,7 +1357,7 @@ static int rwnx_close(struct net_device *dev)
 			if (testmode == 0) {
 				rwnx_send_me_config_req(rwnx_hw);
 				// Set channel parameters to firmware
-				rwnx_send_me_chan_config_req(rwnx_hw, rwnx_hw->wiphy->regd->alpha2);
+				rwnx_send_me_chan_config_req(rwnx_hw, rwnx_hw->last_alpha2[0] ? rwnx_hw->last_alpha2 : (char *)"00");
 			}
 		}
 #endif
@@ -5431,7 +5431,6 @@ static void rwnx_reg_notifier(struct wiphy *wiphy,
 
 	printk("%s Enter\r\n", __func__);
 
-	int delta_min = 100;
 	ktime_t now = ktime_get();
 
 	AICWFDBG(LOGINFO, "%s\n", __func__);
@@ -5439,17 +5438,12 @@ static void rwnx_reg_notifier(struct wiphy *wiphy,
 	if (!rwnx_hw->mod_params->custregd) {
 		AICWFDBG(LOGINFO, "regulatory domain set to %c%c, initiator: %d\n", alpha2[0], alpha2[1], initiator);
 
-		if (rwnx_hw->last_alpha2[0]) {
-			s64 delta = ktime_ms_delta(now, rwnx_hw->last_time);
-			if (delta < 0 || delta > INT_MAX)
-				delta = delta_min + 1;
-			if (delta < delta_min) {
-				AICWFDBG(LOGDEBUG, "suspicious rapid reg change: %s -> %s\n", rwnx_hw->last_alpha2, request->alpha2);
-				return;
-			}
-		}
-
-		regulatory_hint(wiphy, alpha2);
+		/*
+		 * cfg80211 has applied this request already. Feeding it back as a
+		 * driver hint turned a user's country into an intersection that a
+		 * later change could not replace, and the 100 ms shortcut skipped
+		 * the firmware channel update below.
+		 */
 		memcpy(rwnx_hw->last_alpha2, request->alpha2, 2);
 		rwnx_hw->last_time = now;
 
diff --git a/src/aic8800-vendor/aic8800_fdrv/rwnx_mod_params.c b/src/aic8800-vendor/aic8800_fdrv/rwnx_mod_params.c
index 0ad6d22..d8e0603 100755
--- a/src/aic8800-vendor/aic8800_fdrv/rwnx_mod_params.c
+++ b/src/aic8800-vendor/aic8800_fdrv/rwnx_mod_params.c
@@ -55,8 +55,9 @@ struct rwnx_mod_params rwnx_mod_params = {
 	COMMON_PARAM(mutx, true, true)
 	COMMON_PARAM(mutx_on, true, true)
 	COMMON_PARAM(use_80, false, false)
-/* false: use crda(iw reg set CN); true: drive self-management(wifi_test wlan0 country_set CN) */
-	COMMON_PARAM(custregd, true, true)
+/* false: cfg80211 and regulatory.db (iw reg set, wpa_supplicant/hostapd country);
+ * true: the driver's own permissive table, self-managed */
+	COMMON_PARAM(custregd, false, false)
 	COMMON_PARAM(custchan, false, false)
 	COMMON_PARAM(roc_dur_max, 500, 500)
 	COMMON_PARAM(listen_itv, 0, 0)
