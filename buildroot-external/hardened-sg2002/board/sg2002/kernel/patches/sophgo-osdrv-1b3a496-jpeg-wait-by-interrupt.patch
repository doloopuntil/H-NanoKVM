From: Gleb Pesin <dormancygrace@gmail.com>
Date: Wed, 21 Oct 2026 00:11:33 +0300
Subject: [PATCH] jpeg: wait for the encode by its interrupt

The JPU's end of picture was found by polling MJPEG_PIC_STATUS_REG with
usleep_range(800, 1200): up to about a millisecond late on every JPEG
and a CPU wakeup every millisecond while it encodes. The device tree
gives the JPU its interrupt (PLIC 20), but the driver never requested it
and jdi_wait_interrupt had the interrupt path disabled.

The driver now requests the interrupt. Its handler masks the JPU
interrupt (the next picture's software reset unmasks it) and wakes the
waiter. jdi_wait_interrupt waits for that wakeup and still reads the
status register, so a late wakeup from an earlier picture is not taken
for this one; without the interrupt it polls as before.

[Adapted to this tree: the vendor handler and the compiled-out request_irq
are replaced in place; the probe error path also frees the interrupt.]
---
 interdrv/cvi_vc_drv/jpeg/jdi/linux/jdi.c | 33 +++++++------
 interdrv/jpeg/cvi_jpeg.c                 | 63 +++++++++++++++---------
 2 files changed, 59 insertions(+), 37 deletions(-)

diff --git a/interdrv/cvi_vc_drv/jpeg/jdi/linux/jdi.c b/interdrv/cvi_vc_drv/jpeg/jdi/linux/jdi.c
index c134f18..915db02 100644
--- a/interdrv/cvi_vc_drv/jpeg/jdi/linux/jdi.c
+++ b/interdrv/cvi_vc_drv/jpeg/jdi/linux/jdi.c
@@ -33,6 +33,7 @@ typedef sem_t MUTEX_HANDLE;
 #else
 typedef struct mutex MUTEX_HANDLE;
 extern int jpu_wait_interrupt(int timeout);
+extern bool jpu_has_interrupt(void);
 extern int jpu_set_clock_gate(int *pEnable);
 extern int jpu_get_instance_pool(jpudrv_buffer_t *p_jdb);
 extern int jpu_open_instance(unsigned long *pInstIdx);
@@ -1194,19 +1195,23 @@ int jdi_get_clock_gate(void)
 
 int jdi_wait_interrupt(int timeout)
 {
-#if 0//def SUPPORT_INTERRUPT
-	int ret;
-	jdi_info_t *jdi;
-
-	jdi = &s_jdi_info[0];
-	ret = jpu_wait_interrupt(timeout);
-	if (ret != 0)
-		ret = -1;
-
-	// printf("receive a interrupt ......, ret = %d\n", ret);
-
-	return ret;
-#else
+	if (jpu_has_interrupt()) {
+		/* The status register decides: a wakeup left by an earlier
+		 * picture is not the end of this one. */
+		const unsigned long deadline = jiffies + msecs_to_jiffies(timeout);
+
+		for (;;) {
+			long left;
+
+			if (jdi_read_register(MJPEG_PIC_STATUS_REG))
+				return 0;
+			left = (long)(deadline - jiffies);
+			if (left <= 0)
+				return jdi_read_register(MJPEG_PIC_STATUS_REG) ? 0 : -1;
+			jpu_wait_interrupt(jiffies_to_msecs(left) + 1);
+		}
+	}
+	{
 	Int64 elapse, cur;
 	struct timespec64 tv;
 
@@ -1234,7 +1239,7 @@ int jdi_wait_interrupt(int timeout)
 		usleep_range(800, 1200);
 	}
 	return 0;
-#endif
+	}
 }
 
 void jdi_log(int cmd, int step)
diff --git a/interdrv/jpeg/cvi_jpeg.c b/interdrv/jpeg/cvi_jpeg.c
index c2c7cef..06d8aec 100644
--- a/interdrv/jpeg/cvi_jpeg.c
+++ b/interdrv/jpeg/cvi_jpeg.c
@@ -91,27 +91,34 @@ static void set_clock_enable(struct cvi_jpu_device *jdev, int enable)
 	}
 }
 
-irqreturn_t jpu_irq_handler(int irq, void *data)
+/* The end of a JPU picture: mask the interrupt until the next picture's
+ * software reset unmasks it, and wake the waiter. */
+static irqreturn_t jpu_irq_handler(int irq, void *data)
 {
 	struct cvi_jpu_device *jdev = data;
-	jpudrv_buffer_t *pReg = &jdev->jpu_register;
-
-	if (jpu_chn_idx == -1)
-		return IRQ_HANDLED;
-
-	writel(0xFF, pReg->virt_addr + MJPEG_INTR_MASK_REG);//disable_irq_nosync(jdev->jpu_irq);
-
-	if (jdev->async_queue)
-		kill_fasync(&jdev->async_queue, SIGIO,
-			    POLL_IN); // notify the interrupt to userspace
+	void __iomem *regs = (void __iomem *)jdev->jpu_register.virt_addr;
 
+	if (!regs || !readl(regs + MJPEG_PIC_STATUS_REG))
+		return IRQ_NONE;
+	writel(0xFF, regs + MJPEG_INTR_MASK_REG);
 	jdev->interrupt_flag = 1;
-	wake_up(&tWaitQueue[jpu_chn_idx]);
 	wake_up(&jdev->interrupt_wait_q);
-
 	return IRQ_HANDLED;
 }
 
+/* Whether jpu_wait_interrupt has an interrupt to wait for. use_irq=0 polls
+ * the status register as before (for comparison; switchable at runtime). */
+static bool jpu_irq_requested;
+static bool use_irq = true;
+module_param(use_irq, bool, 0644);
+MODULE_PARM_DESC(use_irq, "Wait for the JPU end of picture by its interrupt (0: poll the status)");
+
+bool jpu_has_interrupt(void)
+{
+	return jpu_irq_requested && READ_ONCE(use_irq);
+}
+EXPORT_SYMBOL(jpu_has_interrupt);
+
 // JDI_IOCTL_WAIT_INTERRUPT
 int jpu_wait_interrupt(int timeout)
 {
@@ -442,14 +449,19 @@ static int jpu_probe(struct platform_device *pdev)
 			jdev->pdata->ops->clk_get(jdev);  // jpu_clk_get
 	}
 
-	/* The JPU IRQ is unused (request_irq below is compiled out); jpu_irq stays 0 so remove skips free_irq. */
-#if 0
-	err = request_irq(jdev->jpu_irq, jpu_irq_handler, 0, "JPU_CODEC_IRQ", jdev);
-	if (err) {
-		pr_err("[JPUDRV] :  fail to register interrupt handler\n");
-		goto ERROR_PROBE_DEVICE;
+	/* The device tree gives the interrupt; without it the driver polls. */
+	init_waitqueue_head(&jdev->interrupt_wait_q);
+	if (pdev && jdev->jpu_register.virt_addr) {
+		const int irq = platform_get_irq_optional(pdev, 0);
+
+		jdev->interrupt_flag = 0;
+		if (irq > 0 && request_irq(irq, jpu_irq_handler, 0, "jpeg", jdev) == 0) {
+			jdev->jpu_irq = irq;
+			jpu_irq_requested = true;
+		} else {
+			pr_warn("[JPUDRV] : no JPU interrupt, polling the status\n");
+		}
 	}
-#endif
 #ifndef USE_VMALLOC_FOR_INSTANCE_POOL_MEMORY
 	if (jpu_allocate_memory(jdev, pdev) < 0) {
 		pr_err("[JPUDRV] :  fail to remap jpu memory\n");
@@ -469,8 +481,6 @@ static int jpu_probe(struct platform_device *pdev)
 		jdev->pdata->ops->config_pll(jdev); //cv1835_config_pll
 	}
 
-	init_waitqueue_head(&jdev->interrupt_wait_q);
-
 	spin_lock_init(&jdev->jpu_lock);
 
 	INIT_LIST_HEAD(&jdev->s_jbp_head);
@@ -482,6 +492,11 @@ static int jpu_probe(struct platform_device *pdev)
 
 ERROR_PROBE_DEVICE:
 
+	if (jpu_irq_requested) {
+		jpu_irq_requested = false;
+		free_irq(jdev->jpu_irq, jdev);
+	}
+
 	if (jdev->s_jpu_major)
 		unregister_chrdev_region(jdev->cdev_id, 1);
 
@@ -594,8 +609,10 @@ static void jpu_remove(struct platform_device *pdev)
 
 	cvi_jpu_unregister_cdev(pdev);
 
-	if (jdev->jpu_irq)
+	if (jpu_irq_requested) {
+		jpu_irq_requested = false;
 		free_irq(jdev->jpu_irq, jdev);
+	}
 
 	if (jdev->jpu_register.virt_addr) {
 		iounmap((void *)jdev->jpu_register.virt_addr);
