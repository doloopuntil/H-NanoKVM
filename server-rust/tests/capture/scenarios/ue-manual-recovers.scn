# ue: the scan gives up, manual mode with the wrong size, then the right size: reads recover.
chip ue
board beta
file /etc/kvm/hdmi_mode 0
file /kvmapp/kvm/state 0\n
file /kvmapp/kvm/width 1920\n
file /kvmapp/kvm/height 1080\n
vidbg auto
src 1234 567
call init
at 500
call mjpeg 1920 1080 80 every 2000 until 90000
at 90000
file /kvmapp/kvm/width 1234\n
file /kvmapp/kvm/height 567\n
at 90000
call mjpeg 1920 1080 80 every 2000 until 130000
at 130000
end
