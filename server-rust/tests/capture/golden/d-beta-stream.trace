@1500 i2c 2b w ff e0
@1500 i2c 2b w 8e
@1500 i2c 2b r 04 38
@1500 i2c 2b w 8c
@1500 i2c 2b r 03 c0
@1500 write /kvmapp/kvm/width "1920\n"
@1500 write /kvmapp/kvm/height "1080\n"
@1500 run sync
@1600 cam mirror_flip
@1616..@2916 call mjpeg 1920 1080 80 -> 0 jpeg 1920x1080 q80 size=1080 x14
@3000 > src 1280 720
@3000 > int fall
@3000 write /proc/lt_int "0"
@3000 i2c 2b w ff e0
