@0 > file /etc/kvm/hdmi_mode 0
@0 > file /kvmapp/kvm/state 0\n
@0 > file /kvmapp/kvm/width 1920\n
@0 > file /kvmapp/kvm/height 1080\n
@0 > vidbg auto
@0 > src 1920 1080
@0 call init
@0 cam create 1920x1080 in=1920x1080
@0 cam mirror_flip
@0 write /kvmapp/kvm/state "0\n"
@0 gpio claim offset=3 lines=1 out=1 value=1 consumer=libkvm
@0 gpio hdmi-reset 0
@0 run /kvmapp/system/init.d/S15kvmhwd get_hdmi_version
@0 write /etc/kvm/hdmi_mode "0\n"
@10 gpio hdmi-reset 1
@10 write /kvmapp/kvm/state "0\n"
@1000 vi_state seq=2 dev_fps=60 fps=60 width_gt=0 width_ls=0 height_gt=0 height_ls=0
@1000 write /kvmapp/kvm/state "1\n"
@1100 cam mirror_flip
@1196..@2007 call mjpeg 1920 1080 80 -> 0 jpeg 1920x1080 q80 size=1080 x28
@2007 call hdmi 0
@2007 write /kvmapp/kvm/state "0\n"
@2007 gpio hdmi-reset 0
@2007 call hdmi 0 -> 0
@2007 call signal -> 0
@3000 call hdmi 1
@3000 gpio hdmi-reset 1
@3000 write /kvmapp/kvm/state "1\n"
@3000 call hdmi 1 -> 0
@3096..@3511 call mjpeg 1920 1080 80 -> 0 jpeg 1920x1080 q80 size=1080 x16
@3511 call signal -> 1
@3511 call deinit
@3600 write /kvmapp/kvm/state "0\n"
@3600 cam close
@3600 mmf deinit force
@3600 call deinit done
@4000 end
