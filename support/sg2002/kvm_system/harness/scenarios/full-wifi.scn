# Full board with a Wi-Fi module: wifi_state 0 and 1, the IP line alternating
# between Ethernet and Wi-Fi, the wifi_exist marker and the wifi_state file.
i2c 5 0x3d
input
file /etc/kvm/hw beta\n
file /kvmapp/kvm/now_fps 0\n
file /kvmapp/kvm/type mjpeg\n
file /kvmapp/kvm/qlty 80\n
file /kvmapp/kvm/width 1920\n
file /kvmapp/kvm/height 1080\n
file /sys/class/udc/4340000.usb/state configured\n
file /sys/kernel/config/usb_gadget/g0/configs/c.1/hid.GS0
vi 60
iface eth0 running 192.168.1.20
route eth0 192.168.1.1
iface wlan0 up -
at 4000
iface wlan0 running 192.168.2.30
at 7000
route wlan0 192.168.2.1
at 30000
route eth0 -
at 36000
iface wlan0 running 192.168.2.31
at 42000
route wlan0 -
route eth0 192.168.1.1
at 48000
iface wlan0 absent
at 52000
end
