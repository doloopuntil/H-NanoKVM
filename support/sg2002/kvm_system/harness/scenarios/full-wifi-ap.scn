# Wi-Fi setup over the AP: long press, AP start with a fresh key, QR and text pages,
# a phone joins, the config-URL QR and text pages, credentials arrive, connected.
i2c 5 0x3d
input
file /etc/kvm/hw beta\n
file /kvmapp/kvm/now_fps 0\n
file /kvmapp/kvm/type mjpeg\n
file /kvmapp/kvm/qlty 80\n
file /kvmapp/kvm/width 1920\n
file /kvmapp/kvm/height 1080\n
file /sys/class/udc/4340000.usb/state configured\n
file /sys/kernel/config/usb_gadget/g0/configs/c.1/hid.GS0
vi 60
iface eth0 running 192.168.1.20
route eth0 192.168.1.1
iface wlan0 up -
at 2050
key press 2000
at 6500
iface wlan0 running 10.20.30.1
at 7050
key press 100
at 9050
key press 100
at 10500
sta on
at 12050
key press 100
at 14050
key press 100
at 15050
key press 100
at 16500
file /kvmapp/kvm/wifi_try_connect
sta off
at 20000
wpa COMPLETED
iface wlan0 running 192.168.2.30
route wlan0 192.168.2.1
at 30000
end
