@0 > file /etc/kvm/hw beta\n
@0 > file /etc/kvm/oled_exist
@0 > file /etc/kvm/wifi_exist
@0 > file /kvmapp/kvm/now_fps 0\n
@0 > file /kvmapp/kvm/type mjpeg\n
@0 > file /kvmapp/kvm/qlty 80\n
@0 > file /kvmapp/kvm/width 1920\n
@0 > file /kvmapp/kvm/height 1080\n
@0 > file /sys/class/udc/4340000.usb/state configured\n
@0 > file /sys/kernel/config/usb_gadget/g0/configs/c.1/hid.GS0
@0 > vi 60
@0 > iface eth0 running 192.168.1.20
@0 > route eth0 192.168.1.1
@0 i2c 5:3d NACK C ae
@0 unlink /etc/kvm/oled_exist
@0 unlink /etc/kvm/wifi_exist
@2050 > key press 2000
@5500 > file /kvmapp/kvm/wifi_try_connect
@6000 unlink /kvmapp/kvm/wifi_try_connect
@6000 run /etc/init.d/S30wifi restart
@6000 run wpa_cli -i wlan0 status
@8000 > end
@8000 exit 0
