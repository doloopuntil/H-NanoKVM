 /*
  * Brief: get picture size(w*h), according enPicSize
  */
+/* One decimal dimension from a file the server writes; the fallback when missing or invalid. */
+static CVI_U32 kvm_read_dimension(const char *path, CVI_U32 fallback)
+{
+	char buf[16];
+	char *end;
+	unsigned long value;
+	size_t len;
+	FILE *fp = fopen(path, "r");
+
+	if (!fp)
+		return fallback;
+	len = fread(buf, 1, sizeof(buf) - 1, fp);
+	fclose(fp);
+	buf[len] = '\0';
+	value = strtoul(buf, &end, 10);
+	if (end == buf || value == 0 || value > 8192)
+		return fallback;
+	return (CVI_U32)value;
+}
